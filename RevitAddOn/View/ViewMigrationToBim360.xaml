<UserControl
    x:Class="Revit.SDK.Samples.CloudAPISample.CS.View.ViewMigrationToBim360"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="1400"
    mc:Ignorable="d">
    <Grid Background="#FFE5E5E5">
        <Grid.Resources>
            <Style x:Key="Space" TargetType="{x:Type Control}">
                <Setter Property="Margin" Value="5" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,5,0,5" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Height" Value="24" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="127*" />
            <ColumnDefinition Width="53*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="Black" />
                    <GradientStop Offset="1" Color="#FFDFDCDC" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid
                Width="247"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Name="btnSignIn"
                    Grid.ColumnSpan="2"
                    Margin="5,5"
                    Click="OnBtnLogin_Click"
                    Content="Sign In" />
                <Button
                    Name="btnSignout"
                    Grid.ColumnSpan="2"
                    Margin="5,5"
                    Click="OnBtnLogout_Click"
                    Content="Sign Out"
                    Visibility="Hidden" />
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="10">
                <Label
                    Margin="0,0"
                    Content="Step 1. Download Models"
                    FontSize="14"
                    FontWeight="Bold" />
                <Label Content="Select folder from ACC" />
                <TreeView
                    Name="treeDataManagement"
                    Height="200"
                    Margin="5,0" />
                <Label Content="Select local folder to download" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Name="tbLocalFolder"
                        Grid.Column="0"
                        Height="Auto"
                        Margin="5" />
                    <Button
                        Grid.Column="1"
                        Width="60"
                        Margin="5,5,10,5"
                        HorizontalAlignment="Left"
                        Click="OnBtnBrowseDirectory_Click">
                        ...
                    </Button>
                </Grid>
                <Button
                    Name="btnDownloadFolder"
                    Margin="5"
                    Click="OnBtnDownload_Click">
                    Start Downloading from ACC
                </Button>
                <TextBlock
                    Margin="10"
                    FontStyle="Italic"
                    TextWrapping="Wrap"><Run Text="- You can either download models from BIM 360 Team use this tool, or download models manually from UI" /></TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10">
                <Label
                    Margin="5,0"
                    Content="Step 2. Config Target Folder"
                    FontSize="14"
                    FontWeight="Bold" />
                <Label Content="Select Output BIM360 Docs Folder" />
                <TreeView
                    Name="treeDataManagementOutput"
                    Height="281"
                    Margin="5,0" />
                <TextBlock
                    Height="Auto"
                    Margin="10"
                    FontStyle="Italic"
                    TextWrapping="Wrap"><Run Text="- Make sure to select a folder of BIM 360 Docs to upload the model to." /></TextBlock>
            </StackPanel>
            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="Step 3. Upload Revit Models"
                        FontSize="14"
                        FontWeight="Bold" />
                    <Button Click="OnBtnUpload_Click">Upload</Button>
                    <Label Name="lbUploadStatus" Content="Progress" />
                    <ProgressBar Name="pbUploading" Height="20" />
                    <TextBlock
                        Margin="10"
                        FontStyle="Italic"
                        TextWrapping="Wrap">
                        - Ensure you are also logged in to your Autodesk Account.<LineBreak /><LineBreak />
                        - Click “Upload” to upload models to the target BIM 360 Docs folder.</TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="Step 4. Reload"
                        FontSize="14"
                        FontWeight="Bold" />
                    <Button Click="OnBtnRefresh_Click">Refresh</Button>
                    <Label Name="lbReloadStatus" Content="Progress" />
                    <ProgressBar Name="pbReloading" Height="20" />
                    <TextBlock
                        Margin="10"
                        FontStyle="Italic"
                        TextWrapping="Wrap">
                        - Click “Refresh” to direct links to the correct model in the cloud.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>